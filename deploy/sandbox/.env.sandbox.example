# Orcha Sandbox Environment
# Copy to .env.sandbox, fill in secrets, never commit the filled copy.
# -----------------------------------------------------------------------------

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password_here

# ── LLM Routing (any OpenAI-compatible provider) ─────────────────────────────
# OpenRouter: OPENROUTER_API_KEY=sk-or-... and leave BASE_URL default.
# Gemini (free key at aistudio.google.com): set key + the two lines below.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ORCHESTRATOR_MODEL=gemini-2.5-flash
# SMALL_MODEL=gemini-2.5-flash

# Models used by Planning & Discovery
LLM_DECOMPOSITION_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_VALIDATION_MODEL=openai/gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
LLM_EMBEDDING_PROVIDER=ollama

# ── SuperAgent LLM ────────────────────────────────────────────────────────────
ORCHESTRATOR_MODEL=anthropic/claude-haiku-4.5
SMALL_MODEL=anthropic/claude-haiku-4.5
ANTHROPIC_API_KEY=sk-ant-...
# or OPENAI_API_KEY= if routing through OpenAI directly

# ── Spend Protection ──────────────────────────────────────────────────────────
# Max message requests forwarded per day across all sandbox sessions.
# Launch posture: 150/day @ ~$0.05 avg (cheap models above) = ~$7/day ceiling.
SANDBOX_MAX_DAILY_MESSAGES=150
# Messages per guest account on public sandbox (GET /auth/guest)
SANDBOX_GUEST_MAX_MESSAGES=2
# Higher cap for guests who bring their own model key (no LLM spend on us)
SANDBOX_GUEST_BYOK_MAX_MESSAGES=10

# ── Agent API Keys ────────────────────────────────────────────────────────────
SERPER_API_KEY=          # search-agent (Google Serper) — leave blank for mock
# Google Workspace orchestrator — real OAuth (see docs/dev_docs/GWS-LIVE-TEST.md).
# Create a Web-application OAuth client in Google Cloud Console with
# Authorized redirect URI exactly: http://localhost:3011/auth/callback
GOOGLE_OAUTH_CLIENT_ID=          # leave blank to keep gws-orchestrator in unauthenticated mode
GOOGLE_OAUTH_CLIENT_SECRET=      # required for the token exchange + refresh
# E-commerce automation agent — every integration below is independently
# optional; leave any of them blank to keep that integration mock-mode (see
# agents/ecommerce-automation/README.md). Shopify OAuth callback needs
# Authorized redirect URI exactly: http://localhost:3009/auth/callback
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=            # static token — simplest path, skips OAuth
SHOPIFY_OAUTH_CLIENT_ID=         # alternative to a static token: OAuth flow
SHOPIFY_OAUTH_CLIENT_SECRET=
FB_ACCESS_TOKEN=
FB_PAGE_ID=
IG_ACCESS_TOKEN=
IG_USER_ID=
# lead-gen: set in its own .env file if needed (not part of the sandbox compose env_file)

# ── Gateway Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
VAULT_KEY=<generate-with-openssl-rand-base64-32>
REGISTRY_INTERNAL_KEY=dev-internal-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash, no wildcards).
# Default covers the sandbox served through nginx (http://localhost, port 80) and
# a local Vite dev server (http://localhost:3000). Without the portless entry a
# browser hitting the sandbox at http://localhost is CORS-blocked before it can
# reach /auth/register or /auth/login.
CORS_ORIGINS=http://localhost,http://localhost:3000
# For a public UI (Vercel + tunnel backend) — add your own domain(s):
# CORS_ORIGINS=http://localhost,https://app.orcha.ai,https://orcha.vercel.app

# ── Payments (mock mode — no wallet needed) ────────────────────────────────────
PAYMENT_MODE=mock
