{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solvent-labs-org/metaorcha/docs/spec/emerge-yaml.schema.json",
  "title": "emerge.yaml",
  "description": "Agent manifest for the Orcha orchestration runtime. Versioned, frozen-by-default. Changes go through the RFC process in docs/spec/governance.md.",
  "type": "object",
  "required": ["identity", "protocol", "health_endpoint", "security"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this manifest schema. Defaults to \"1.0\" when absent. \"1.1\" adds the optional authorized_scope block (RFC 0001). \"1.2\" adds optional AAC charter sub-fields to authorized_scope (RFC 0002).",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "default": "1.0"
    },
    "identity": {
      "type": "object",
      "required": ["id", "name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Decentralized identifier. did:orcha:agent:* for user agents, did:orcha:system:* for platform tools.",
          "pattern": "^did:orcha:(agent|system):[A-Za-z0-9._-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "public_key": {
          "type": "string",
          "description": "Optional base64 Ed25519 public key for signed identity (emerge/1.1). Unused in mock OSS mode."
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["type", "version", "transport"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mcp", "a2a", "acp", "computer_use"],
          "description": "acp is accepted for compatibility and routes through the A2A handler at runtime (IBM's ACP merged into A2A upstream in August 2025); it is not an independently maintained protocol."
        },
        "version": { "type": "string" },
        "transport": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["sse", "stdio", "http"] },
            "endpoint": { "type": "string", "description": "Required for sse/http transports." },
            "command": { "type": "string", "description": "Required for stdio transport." },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Env var templates for stdio agents, e.g. {\"KEY\": \"${KEY}\"}."
            }
          }
        }
      }
    },
    "health_endpoint": { "type": "string", "minLength": 1 },
    "security": {
      "type": "object",
      "required": ["transport_layer"],
      "additionalProperties": false,
      "properties": {
        "transport_layer": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["tls", "mtls", "none"] },
            "mtls_config": {
              "type": "object",
              "required": ["cert_vault_key", "key_vault_key", "ca_vault_key"],
              "properties": {
                "cert_vault_key": { "type": "string" },
                "key_vault_key": { "type": "string" },
                "ca_vault_key": { "type": "string" }
              }
            }
          }
        },
        "auth_strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "config"],
            "properties": {
              "id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["x_api_key", "http_bearer", "oauth2", "oauth2_dcr"]
              },
              "capability_ids": { "type": "array", "items": { "type": "string" } },
              "config": { "type": "object" }
            }
          }
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "base_fee": {
          "type": ["string", "null"],
          "description": "Price per invocation in USD as a string, e.g. \"0.15\". Null/absent means free."
        }
      }
    },
    "network": {
      "type": "object",
      "description": "Experimental network configuration. Requires network.experimental: true.",
      "additionalProperties": false,
      "properties": {
        "experimental": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to pre-release network features (validate live, gossip transport)."
        },
        "gossip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "bootstrap_peers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Multiaddr bootstrap peers for emerge-node (Phase 0)."
            }
          }
        },
        "cognitive_loop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "cycle_seconds": { "type": "integer", "minimum": 1, "default": 120 }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "A2A skills — harvested from /.well-known/agent.json at registration; listed for documentation and PnD embedding.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "authorized_scope": {
      "type": "object",
      "description": "Optional declared limits on the agent's authorised behaviour (emerge/1.1, RFC 0001; extended with optional AAC charter sub-fields in emerge/1.2, RFC 0002). Consumed by supervisors/verifiers; absence means 'unspecified', not 'unrestricted'.",
      "additionalProperties": false,
      "properties": {
        "allowed_capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Capability/skill names the agent may invoke."
        },
        "spend_cap_usd": {
          "type": "string",
          "description": "Maximum machine-to-machine payment volume in scope, USD decimal as string, e.g. \"5000.00\"."
        },
        "allowed_counterparties": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed payee / counterparty identifiers."
        },
        "jurisdictions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Authorised operating jurisdictions (ISO 3166-1 alpha-2 or regime codes)."
        },
        "principal": {
          "type": "object",
          "description": "Legal entity accountable for the agent (emerge/1.2, RFC 0002).",
          "additionalProperties": false,
          "required": ["legal_name", "identifier_type", "identifier_value"],
          "properties": {
            "legal_name": { "type": "string", "minLength": 1 },
            "identifier_type": {
              "type": "string",
              "enum": ["CIN", "GST", "Aadhaar", "CNPJ", "UEN", "LEI"],
              "description": "Typed legal identifier scheme (India CIN/GST/Aadhaar, Brazil CNPJ, Singapore UEN, global LEI)."
            },
            "identifier_value": { "type": "string", "minLength": 1 },
            "regulator_license": {
              "type": "string",
              "description": "Optional regulator-issued licence reference."
            }
          }
        },
        "rails": {
          "type": "array",
          "items": { "type": "string" },
          "description": "DPI rails the authorisation covers, e.g. UPI, AccountAggregator, ULI (emerge/1.2, RFC 0002)."
        },
        "delegation": {
          "type": "object",
          "description": "Whether the agent may issue sub-agent charters, and to what depth (emerge/1.2, RFC 0002).",
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "boolean", "default": false },
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Maximum delegation hops permitted below this charter."
            }
          }
        },
        "human_approval_required_above": {
          "type": "string",
          "description": "Transaction value above which a named human must approve, decimal as string (emerge/1.2, RFC 0002)."
        },
        "validity": {
          "type": "object",
          "description": "Charter validity window, RFC 3339 datetimes (emerge/1.2, RFC 0002).",
          "additionalProperties": false,
          "properties": {
            "not_before": { "type": "string", "format": "date-time" },
            "not_after": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
