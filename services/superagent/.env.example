# SuperAgent Service — copy to .env

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Main ReAct orchestrator (cheap default). Override with e.g. google/gemini-2.0-flash-001 on OpenRouter.
ORCHESTRATOR_MODEL=anthropic/claude-3.5-haiku
# PnD gate Tier-3 classifier — keep small/cheap.
SMALL_MODEL=anthropic/claude-3.5-haiku

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=DEBUG

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://test:test123@localhost:5432/orcha-db

# VAULT_KEY: base64-encoded 32-byte AES-256-GCM key
# Generate with: openssl rand -base64 32
VAULT_KEY=<generate-with-openssl-rand-base64-32>

# ── Downstream services ───────────────────────────────────────────────────────
PND_SERVICE_URL=http://localhost:8001
REGISTRY_SERVICE_URL=http://localhost:8000
REGISTRY_INTERNAL_KEY=dev-internal-secret

# ── Platform system MCP tools (injected into MCP subprocess env via platform_env) ──
# Web search (tavily-mcp) — required for seeding/registering the web-search agent
TAVILY_API_KEY=
# Web scraper (firecrawl-mcp) — required for web-scraper platform agent
FIRECRAWL_API_KEY=

# ── Platform manifests path (local dev: repo root relative or absolute) ─────────
EMERGE_TOOLS_DIR=./common/emerge-tools

# ── Artifacts / S3 (LocalStack in dev: http://localhost:4566) ─────────────────
ARTIFACT_S3_BUCKET=emerge-artifacts-local
S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Slice 1 — DAG planner routing (default off = stock ReAct loop)
DAG_PLANNER_ENABLED=false
DAG_ROUTE_HIGH=0.75
DAG_ROUTE_LOW=0.35
# DAG_ROUTE_MODEL=anthropic/claude-haiku-4.5   # Channel B arbiter; defaults to SMALL_MODEL

# Slice 1 — CDV step verification (default off)
CDV_VERIFICATION_ENABLED=false
CDV_STORE_DIR=.cdv-runs

# Run attestation (KYA, RFC 0003; default off) — sign every completed run into
# an orcha.run-attestation/v1 envelope. Requires the validator package.
RUN_ATTESTATION_ENABLED=false
# RUN_ATTESTATION_POLICY_VERSION=run-attestation/1.0
# RUN_ATTESTATION_CHARTER_HASH — 64-char lowercase hex sha256 of the canonical
# charter fixture. When set, produced envelopes carry this charter_hash (the
# run is on the settling path, AD-9); when unset/blank, charter_hash is null.
# KYA settlement slice demo: sha256 of docs/spec/fixtures/demo-charter.json.
# RUN_ATTESTATION_CHARTER_HASH=
# ATTESTATION_PRIVATE_KEY_B64=   # required when RUN_ATTESTATION_ENABLED=true
# ATTESTATION_ALLOW_EPHEMERAL_KEY=1  # dev/test only; receipts will not survive a restart
# Mint a seed (never write the value to disk or git):
# python -c "from emerge_node.envelope import generate_keypair; from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, NoEncryption; import base64; k,_=generate_keypair(); print(base64.b64encode(k.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption())).decode())"

# Settlement gate (AD-2, AD-12; default off) — with the gate on, every sealed
# run is judged after the receipt seals and a firing that fails is refused;
# settlement clears only against a valid, charter-bound, run-id-matched
# receipt. Default false keeps the stock per-call settle path. Left as a
# comment: run-all.sh sources this file over the shell, so an explicit value
# here would beat an exported one.
# SETTLEMENT_REQUIRE_ATTESTATION=false
# User connections (AD-18; default off) — a tool server plus the user's own
# token, registered from the chat. Off: the Gateway refuses to register one
# (POST /api/v1/plugins/mcp) or to save or schedule a routine on one, and a
# call to a connection already registered is refused here before any
# request. Must match the Gateway's CONNECTIONS_ENABLED.
# CONNECTIONS_ENABLED=false
# With RUN_ATTESTATION_ENABLED, SETTLEMENT_REQUIRE_ATTESTATION and
# CONNECTIONS_ENABLED all off, no receipt or gate observer is installed (the
# audit-ledger and CDV observers have their own flags), nothing is sealed or
# gated, and no connection can be registered or called (story 3.4).
