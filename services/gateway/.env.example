# Gateway Service — copy to .env and fill in secrets

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orcha?schema=public

# Redis (DB 1 — isolated from SuperAgent which uses DB 0)
REDIS_URL=redis://localhost:6379/1

# JWT — generate key with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Downstream services (orcha-core Docker / supervisord — see deploy/supervisord.conf)
# SuperAgent :8001, Planning-discovery :8002, Registry :8003, Gateway :8000
SUPERAGENT_URL=http://127.0.0.1:8001
REGISTRY_URL=http://127.0.0.1:8003
# Internal wallet microservice (Node.js — runs on same host via supervisord)
WALLET_SERVICE_URL=http://localhost:4333/internal

# Privy embedded-wallet credentials (dashboard.privy.io → Settings → API Keys)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Webhook verification secret (dashboard.privy.io → Webhooks)
PRIVY_WEBHOOK_SECRET=
# Privy wallet ID of the platform wallet — dispatch wallet users fund directly
PLATFORM_WALLET_ID=
# Privy wallet ID of the treasury wallet — receives platform cut
TREASURY_WALLET_ID=

# Payment mode — controls settlement and credit seeding:
#   mock     = no settlement cron; new users seeded with 5000 USDC credits for testing
#              pricing guard + deduction logic still runs — only settlement is skipped
#   testnet  = settlement cron runs against Base Sepolia USDC
#   mainnet  = settlement cron runs against Base mainnet USDC
PAYMENT_MODE=mock

# Unique instance ID used for settlement distributed lock
GATEWAY_INSTANCE_ID=gateway-1

# User connections (spine AD-18; default off) — a tool server plus the user's
# own token, registered from the chat. Off: POST /api/v1/plugins/mcp refuses,
# and so do saving or scheduling a routine on a connection. Must match
# SuperAgent's CONNECTIONS_ENABLED.
# CONNECTIONS_ENABLED=false

# Scheduler intervals (seconds) — override to speed up in dev
SETTLEMENT_INTERVAL_SECONDS=300
METRICS_REFRESH_INTERVAL_SECONDS=3600

# ── Artifacts / S3 ─────────────────────────────────────────────────────────────
# Local dev: run LocalStack (e.g. docker compose from deploy/docker-compose.local.yml) and
#   make s3-init
# Point the gateway at LocalStack; omit S3_ENDPOINT_URL only when using real AWS.
ARTIFACT_S3_BUCKET=emerge-artifacts-local
S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
